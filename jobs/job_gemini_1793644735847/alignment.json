{
  "duration": 24.370958333333334,
  "clauses": [
    {
      "start": 0.0,
      "end": 2.82,
      "text": "It's late, and the world is finally quiet."
    },
    {
      "start": 3.62,
      "end": 6.02,
      "text": "If nobody told you today, you did good."
    },
    {
      "start": 6.86,
      "end": 9.1,
      "text": "You survived things you never thought you could,"
    },
    {
      "start": 9.64,
      "end": 10.8,
      "text": "and you are still standing."
    },
    {
      "start": 11.72,
      "end": 12.88,
      "text": "Take off the heavy armor."
    },
    {
      "start": 13.64,
      "end": 15.14,
      "text": "Turn down the noise in your head."
    },
    {
      "start": 15.94,
      "end": 19.1,
      "text": "Tonight, you don't have to prove anything to anyone."
    },
    {
      "start": 20.08,
      "end": 22.32,
      "text": "Let the world spin without you for a few hours."
    },
    {
      "start": 23.24,
      "end": 24.16,
      "text": "You're going to be okay."
    }
  ]
}