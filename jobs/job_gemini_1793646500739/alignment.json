{
  "duration": 24.482375,
  "clauses": [
    {
      "start": 0.0,
      "end": 2.76,
      "text": "Not every season is meant for blooming."
    },
    {
      "start": 3.66,
      "end": 6.1,
      "text": "Some seasons are just for resting, for staying"
    },
    {
      "start": 6.1,
      "end": 7.64,
      "text": "rooted through the coldest nights."
    },
    {
      "start": 8.72,
      "end": 10.58,
      "text": "You don't have to have it all figured"
    },
    {
      "start": 10.58,
      "end": 11.34,
      "text": "out right now."
    },
    {
      "start": 12.18,
      "end": 15.04,
      "text": "You're still growing even in the quiet dark."
    },
    {
      "start": 16.0,
      "end": 17.84,
      "text": "Be proud of how far you've come."
    },
    {
      "start": 18.94,
      "end": 21.12,
      "text": "Soften your shoulders, close your eyes."
    },
    {
      "start": 22.14,
      "end": 24.0,
      "text": "Everything can wait until tomorrow."
    }
  ]
}