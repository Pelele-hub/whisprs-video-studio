        [
          {
            "node": "Check Buffer Slots & Dispatch Whisprs Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Buffer Slots & Dispatch Whisprs Video": {
      "main": [
        [
          {
            "node": "Was Video Dispatched?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Was Video Dispatched?": {
      "main": [
        [
          {
